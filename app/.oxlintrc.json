{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y", "import", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // The automatic JSX runtime (jsx: react-jsx) does not need React in scope.
    "react/react-in-jsx-scope": "off",
    // Event data contains hostile strings; rendering it as HTML is never acceptable here.
    "react/no-danger": "error",
    "typescript/no-explicit-any": "error",
    // Side-effect imports are intentional for stylesheets and the test matchers setup.
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }
    ],
    // Cells aren't controls, and form fields are checked by label-has-associated-control
    // (this rule can't see <label htmlFor> or wrapping labels), as the jsx-a11y docs advise.
    "jsx-a11y/control-has-associated-label": [
      "error",
      { "ignoreElements": ["td", "th", "tr", "input", "textarea", "select"] }
    ],
    "jsx-a11y/label-has-associated-control": "error",
    "eqeqeq": "error"
  },
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results"]
}
